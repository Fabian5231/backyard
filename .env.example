# ------------------------------------------------------------------
# Optionaler Zusatzmodus: Browser-Wiedergabe (serverseitiger Browser)
# Standardmäßig aus. Die direkten Embeds bleiben der Normalfall.
# Nur einschalten für eigene Streams oder Quellen, für deren Wiedergabe
# und Weitergabe eine ausdrückliche Erlaubnis vorliegt.
# Dann starten mit:  docker compose --profile browser up -d --build
# ------------------------------------------------------------------
BROWSER_PLAYBACK=0

# Gemeinsames Geheimnis zwischen App und Browser-Container.
# Erzeugen mit:  openssl rand -hex 32
BROWSER_SERVICE_TOKEN=

# Öffentlicher Hostname oder IP dieses Servers (für die WebRTC-Verbindung).
BROWSER_PUBLIC_HOST=streams.deine-domain.de

# Freigegebene Ziele. Ohne Eintrag startet keine Browser-Sitzung.
# Komma-getrennte Hostnamen; ein Eintrag deckt auch Subdomains ab.
BROWSER_ALLOWED_HOSTS=streams.deine-domain.de
# Kurzformen für die Hilfsdomains einer Plattform: youtube, twitch
BROWSER_ALLOWED_PRESETS=

# Passwort, das Zuschauer zum Starten einer Browser-Sitzung brauchen.
# Leer = jeder Besucher der Seite darf Sitzungen starten (im Rahmen der Limits).
BROWSER_VIEWER_PASSWORD=

# Videoformat: h264 = sparsamer, vp8 = läuft auch in Chromium-Bauten ohne
# proprietäre Codecs (manche Linux-Distributionen), kostet dafür mehr CPU.
BROWSER_VIDEO_CODEC=h264

# X-Forwarded-For auswerten. Nur einschalten, wenn ein eigener Reverse-Proxy
# davorsteht – sonst kann sich jeder eine fremde Adresse zuschreiben.
TRUST_PROXY=0

# Grenzen
BROWSER_MAX_SESSIONS=2
BROWSER_WIDTH=1280
BROWSER_HEIGHT=720
BROWSER_FPS=25
BROWSER_VIDEO_BITRATE=2500k
BROWSER_IDLE_TIMEOUT=90
BROWSER_MAX_SESSION_SECONDS=14400
BROWSER_CPU_LIMIT=2.0
BROWSER_MEMORY_LIMIT=2g

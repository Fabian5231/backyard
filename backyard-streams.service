# Alternative ohne Docker: nach /etc/systemd/system/ kopieren,
# Pfad anpassen, dann: systemctl enable --now backyard-streams
[Unit]
Description=Backyard Streams
After=network.target

[Service]
WorkingDirectory=/opt/backyard-streams
ExecStart=/usr/bin/node server.js
Environment=PORT=8080
Environment=HOST=127.0.0.1
Restart=always
User=www-data

[Install]
WantedBy=multi-user.target
